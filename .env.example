# Server-only data configuration. Do not expose these to the browser.
# Use an identifiable contact string for SEC fair-access requests.
SEC_USER_AGENT="Atlas Terminal research@your-domain.example"

# FMP requires a specific Data Display and Licensing Agreement for a multi-user app.
FMP_API_KEY=
# Licensed ticker-tagged news and catalyst feed.
BENZINGA_API_KEY=
# Company news and market WebSocket access are entitlement-dependent.
FINNHUB_API_KEY=
# Alpaca Basic is suitable only for an individual's IEX feed. Do not use it as
# a shared-product data source without a business agreement.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Keep disabled until each vendor's commercial-display entitlement is confirmed.
NEXT_PUBLIC_DATA_MODE=demo
MASSIVE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
